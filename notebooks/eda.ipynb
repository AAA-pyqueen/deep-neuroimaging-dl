# 🧠 Exploratory Data Analysis (EDA)
# This notebook performs EDA on neuroimaging data.

import nibabel as nib
import numpy as np
import matplotlib.pyplot as plt
import os

# Load a sample NIfTI file
file_path = '../data/sample_brain.nii.gz'  # Change to actual path
img = nib.load(file_path)
data = img.get_fdata()
print('Data shape:', data.shape)

# View a middle brain slice
plt.imshow(data[:, :, data.shape[2] // 2], cmap='gray')
plt.title('Middle Brain Slice')
plt.axis('off')
plt.show()

# Basic statistics
print("Voxel Intensity Stats:")
print("Min:", np.min(data))
print("Max:", np.max(data))
print("Mean:", np.mean(data))
print("Std Dev:", np.std(data))

# View histogram of voxel intensities
plt.hist(data.flatten(), bins=100, color='steelblue')
plt.title("Voxel Intensity Histogram")
plt.xlabel("Intensity")
plt.ylabel("Frequency")
plt.show()
